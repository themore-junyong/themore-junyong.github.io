rules_version = '2';
// 도구 보안 규칙. 초대코드(codes)·사용량(use)은 서버 함수만 읽고 씀(준용이 콘솔에서 코드 관리).
// 실시간 반응판(rooms)만 화면이 직접 씀:
//  - 방 문서: 방 번호를 아는 사람은 읽기, 방을 만든 강사만 지금 질문(q) 바꾸기
//  - 답(ans/{질문id}_{uid}): 학생은 열린 질문에 자기 답 1개만 쓰기·고치기, 읽기는 강사만
//  - 방 문서 go{to,t}(강사가 '학생 화면 바꾸기'): 강사만. 들어와 있는 학생 화면이 그 활동으로 넘어감
//  - 방 문서 g{k,s,t}(강사 노트북의 게임 화면 상태): 강사만. 학생 폰 play.html이 같은 문제·점수를 보여 줌
//  - 방 문서 hb(강사 화면이 1분마다 찍는 시각)·closed(방 종료): 강사만. 학생 화면은 hb가 3분 넘게 멈추거나 closed면 끊음
//  - 방 문서 teams(강사가 정한 조 이름 목록, 8개까지): 강사만. 학생은 들어올 때 그중 하나를 고르고, 답·결과에 team으로 붙음
//  - 방 문서 ak(강사가 방 만들 때 쓴 초대코드): 강사만 씀. 방에 들어온 학생 화면이 AI 도구에 자동으로 씀(학생 코드 입력 없음)
//  - 결과(work/{uid}_{도구}): 방에 들어온 학생이 자소서·검사 등 결과를 도구마다 1개 쓰기·고치기, 읽기는 강사만
service cloud.firestore {
  match /databases/{db}/documents {
    match /{doc=**} { allow read, write: if false; }

    // 내 수업함: 강사마다 자기 초대코드(codes/{코드})로 문서 1개. 코드를 아는 사람만 읽고 씀(목록 보기 불가).
    //  fav(⭐ 자주 쓰는 활동)·teams(조 이름)·name(강사 이름)·sets(실시간 마인드맵 질문 묶음)
    match /teachers/{code} {
      function okCode() {
        return request.auth != null && code != 'PASS'
          && exists(/databases/$(db)/documents/codes/$(code))
          && get(/databases/$(db)/documents/codes/$(code)).data.get('on', true) != false;
      }
      allow get: if okCode();
      allow create, update: if okCode()
        && request.resource.data.keys().hasOnly(['name', 'fav', 'teams', 'sets', 't'])
        && request.resource.data.t == request.time
        && request.resource.data.get('name', '') is string && request.resource.data.get('name', '').size() <= 20
        && request.resource.data.get('fav', []) is list && request.resource.data.get('fav', []).size() <= 40
        && request.resource.data.get('teams', []) is list && request.resource.data.get('teams', []).size() <= 8
        && request.resource.data.get('sets', []) is list && request.resource.data.get('sets', []).size() <= 30;
    }

    match /rooms/{pin} {
      allow get: if request.auth != null;
      allow update: if request.auth != null
        && resource.data.owner == request.auth.uid
        && resource.data.exp > request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['q', 'hb', 'closed', 'go', 'g', 'teams', 'ak'])
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['go'])
            || request.resource.data.get('go', null) == null
            || (request.resource.data.go.keys().hasOnly(['to', 't'])
                && request.resource.data.go.to is string
                && request.resource.data.go.to.matches('^(home|#jaso|[a-z]+[.]html([?][a-z0-9=&_-]{0,40})?)$')
                && request.resource.data.go.t == request.time))
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['g'])
            || (request.resource.data.g.keys().hasOnly(['k', 's', 't'])
                && request.resource.data.g.k is string && request.resource.data.g.k.size() <= 20
                && request.resource.data.g.s is string && request.resource.data.g.s.size() <= 8000
                && request.resource.data.g.t == request.time))
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['teams'])
            || (request.resource.data.teams is list && request.resource.data.teams.size() <= 8))
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['ak'])
            || (request.resource.data.ak is string && request.resource.data.ak.size() <= 40));

      // 이모지 반응: 학생마다 문서 1개(rx/{uid})를 누를 때마다 덮어씀. 강사 화면이 바뀐 것을 세어 띄움
      match /rx/{uid} {
        allow read: if request.auth != null && get(/databases/$(db)/documents/rooms/$(pin)).data.owner == request.auth.uid;
        allow create, update: if request.auth != null && request.auth.uid == uid
          && get(/databases/$(db)/documents/rooms/$(pin)).data.exp > request.time
          && get(/databases/$(db)/documents/rooms/$(pin)).data.get('closed', false) != true
          && request.resource.data.keys().hasOnly(['e', 't'])
          && request.resource.data.e in ['👍', '🤔', '🐢', '😂', '🔥']
          && request.resource.data.t == request.time;
      }

      match /ans/{id} {
        function room() { return get(/databases/$(db)/documents/rooms/$(pin)).data; }
        allow read: if request.auth != null && room().owner == request.auth.uid;
        allow create, update: if request.auth != null
          && room().exp > request.time
          && room().get('closed', false) != true
          && room().q.open == true
          && id == room().q.id + '_' + request.auth.uid
          && request.resource.data.keys().hasOnly(['q', 'v', 'nick', 'team', 't'])
          && request.resource.data.get('team', '') is string && request.resource.data.get('team', '').size() <= 12
          && request.resource.data.q == room().q.id
          && request.resource.data.nick is string && request.resource.data.nick.size() <= 12
          && ((request.resource.data.v is int && request.resource.data.v >= 0 && request.resource.data.v < 6)
              || (request.resource.data.v is string && request.resource.data.v.size() > 0 && request.resource.data.v.size() <= 80))
          && request.resource.data.t == request.time;
      }

      match /work/{id} {
        function room2() { return get(/databases/$(db)/documents/rooms/$(pin)).data; }
        allow read: if request.auth != null && room2().owner == request.auth.uid;
        allow create, update: if request.auth != null
          && room2().exp > request.time
          && room2().get('closed', false) != true
          && request.resource.data.keys().hasOnly(['tool', 'nick', 'team', 'title', 'body', 't'])
          && request.resource.data.get('team', '') is string && request.resource.data.get('team', '').size() <= 12
          && request.resource.data.tool is string && request.resource.data.tool.matches('^[a-z0-9-]{1,24}$')
          && id == request.auth.uid + '_' + request.resource.data.tool
          && request.resource.data.nick is string && request.resource.data.nick.size() > 0 && request.resource.data.nick.size() <= 12
          && request.resource.data.title is string && request.resource.data.title.size() <= 80
          && request.resource.data.body is string && request.resource.data.body.size() <= 6000
          && request.resource.data.t == request.time;
      }
    }
  }
}
