rules_version = '2';

// 교회 출석앱 + 회비 관리 보안 규칙 (Firestore 규칙은 프로젝트에 하나라 둘을 함께 둠)
// - config/admins 문서의 emails 배열에 있는 사람 = 관리자(준용). 모든 교회를 만들고 고칠 수 있음.
// - churches/{교회}.leaders 배열에 있는 사람 = 그 교회를 쓰는 사람. 출석 체크와 성도 정보 보기.
// - churches/{교회}.staff 배열에 있는 사람 = 교역자. 위에 더해 성도 추가·수정·삭제. (앱이 staff도 leaders에 넣어 저장함)
// - churches/{교회}.finance 배열에 있는 사람 = 재정 담당. 헌금·장부(재정)를 보고 넣음. 교역자·리더도 재정은 못 봄.
// - 그 밖의 사람은 아무것도 볼 수 없음.
service cloud.firestore {
  match /databases/{db}/documents {

    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function myEmail() {
      return request.auth.token.email.lower();
    }
    function isAdmin() {
      return signedIn()
        && exists(/databases/$(db)/documents/config/admins)
        && myEmail() in get(/databases/$(db)/documents/config/admins).data.emails;
    }
    function isLeader(cid) {
      return signedIn()
        && myEmail() in get(/databases/$(db)/documents/churches/$(cid)).data.leaders;
    }
    function isStaff(cid) {
      return signedIn()
        && myEmail() in get(/databases/$(db)/documents/churches/$(cid)).data.get('staff', []);
    }
    function canEdit(cid) {
      return isAdmin() || isStaff(cid);
    }
    function canUse(cid) {
      return isAdmin() || isLeader(cid);
    }
    function isFinance(cid) {
      return isAdmin() || (signedIn()
        && myEmail() in get(/databases/$(db)/documents/churches/$(cid)).data.get('finance', []));
    }

    match /config/admins {
      allow read: if isAdmin();
      allow write: if false; // 콘솔에서만 수정
    }

    match /churches/{cid} {
      allow read: if isAdmin() || (signedIn() && (myEmail() in resource.data.leaders || myEmail() in resource.data.get('finance', [])));
      allow write: if isAdmin();

      match /members/{mid} {
        allow read: if canUse(cid) || isFinance(cid);
        allow create, update: if canEdit(cid)
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0;
        allow delete: if canEdit(cid);
      }

      match /attendance/{aid} {
        allow read: if canUse(cid);
        allow create, update: if canUse(cid)
          && request.resource.data.present is bool
          && request.resource.data.checkedBy == myEmail();
        allow delete: if isAdmin();
      }

      // ───────── 재정 (재정 담당·관리자만) ─────────
      match /offerings/{oid} {
        allow read: if isFinance(cid);
        allow create, update: if isFinance(cid)
          && request.resource.data.amount is number
          && request.resource.data.date is string
          && request.resource.data.method in ['현금', '계좌'];
        allow delete: if isFinance(cid);
      }
      match /ledger/{lid} {
        allow read: if isFinance(cid);
        allow create, update: if isFinance(cid)
          && request.resource.data.amount is number
          && request.resource.data.kind in ['in', 'out', 'dep'];
        allow delete: if isFinance(cid);
      }
      match /fin/{doc} {
        allow read, write: if isFinance(cid);
      }
      match /days/{day} {
        allow read, write: if isFinance(cid);
      }
      match /receipts/{rid} {
        allow read: if isFinance(cid);
        allow create, update: if isFinance(cid)
          && request.resource.data.img is string
          && request.resource.data.img.size() < 1000000;
        allow delete: if isFinance(cid);
      }
      // 기부금 영수증 발급 대장 (5년 보관): 지울 수 없음
      match /issued/{iid} {
        allow read: if isFinance(cid);
        allow create, update: if isFinance(cid) && request.resource.data.by == myEmail();
        allow delete: if isAdmin();
      }
      // 재정 수정 기록: 쓴 사람·시각을 속일 수 없고 고칠 수 없음 (교회를 통째로 지울 때만 관리자가 지움)
      match /finlog/{lid} {
        allow read: if isFinance(cid);
        allow create: if isFinance(cid)
          && request.resource.data.by == myEmail()
          && request.resource.data.at == request.time;
        allow update: if false;
        allow delete: if isAdmin();
      }
    }

    // ───────── 회비 관리 (dues/) ─────────
    // dues/{단체}.managers = 총무: 회원·납부·장부 입력과 수정 / viewers = 보기만 / 관리자(config/admins)는 전부
    function duesDoc(gid) {
      return get(/databases/$(db)/documents/dues/$(gid)).data;
    }
    function isDuesManager(gid) {
      return isAdmin() || (signedIn() && myEmail() in duesDoc(gid).get('managers', []));
    }
    function canSeeDues(gid) {
      return isDuesManager(gid) || (signedIn() && myEmail() in duesDoc(gid).get('viewers', []));
    }

    match /dues/{gid} {
      allow read: if isAdmin() || (signedIn() && (myEmail() in resource.data.get('managers', []) || myEmail() in resource.data.get('viewers', [])));
      allow create, delete: if isAdmin();
      // 총무는 시작 잔액 같은 값만 고칠 수 있고, 총무·보기 명단은 관리자만 바꿈
      allow update: if isAdmin() || (isDuesManager(gid)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['managers', 'viewers', 'name']));

      match /members/{mid} {
        allow read: if canSeeDues(gid);
        allow write: if isDuesManager(gid);
      }
      match /payments/{pid} {
        allow read: if canSeeDues(gid);
        allow create, update: if isDuesManager(gid)
          && request.resource.data.month is string
          && request.resource.data.month.matches('^[0-9]{4}-[0-9]{2}$')
          && request.resource.data.amount is number;
        allow delete: if isDuesManager(gid);
      }
      match /ledger/{lid} {
        allow read: if canSeeDues(gid);
        allow create, update: if isDuesManager(gid)
          && request.resource.data.kind in ['in', 'out']
          && request.resource.data.amount is number;
        allow delete: if isDuesManager(gid);
      }
      match /stats/{sid} {
        allow read: if canSeeDues(gid);
        allow write: if isDuesManager(gid);
      }
      // 영수증 사진 (줄인 JPEG, 문서 한도 1MB 안)
      match /receipts/{rid} {
        allow read: if canSeeDues(gid);
        allow create, update: if isDuesManager(gid)
          && request.resource.data.img is string
          && request.resource.data.img.size() < 1000000;
        allow delete: if isDuesManager(gid);
      }
      // 수정 기록: 쓴 사람·시각을 속일 수 없고, 아무도 고치거나 지울 수 없음
      match /log/{lid} {
        allow read: if canSeeDues(gid);
        allow create: if isDuesManager(gid)
          && request.resource.data.by == myEmail()
          && request.resource.data.at == request.time;
        allow update, delete: if false;
      }
    }
  }
}
